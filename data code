        "import random\n",
        "import string\n",
        "\n",
        "def generate_password(count,length):\n",
        "    passwords=[]\n",
        "\n",
        "    for i in range(count):\n",
        "      password = ''.join(\n",
        "          random.choice(string.ascii_letters + string.digits +\n",
        "                        string.punctuation, k=length)\n",
        "      )\n",
        "      passwords.append(password)\n",
        "\n",
        "    return passwords\n",
        "\n",
        "    passwords=generate_password(count=5,length=10)\n",
        "    print(passwords)\n",
        "\n",
        "    for password in passwords:\n",
        "        print(password)"
